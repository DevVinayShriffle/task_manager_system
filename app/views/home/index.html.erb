<div id="app"></div>

<script type="text/template" id="login-template">
  <h2>Login</h2>

  <input type="text" id="email" placeholder="Email"><br><br>
  <input type="password" id="password" placeholder="Password"><br><br>

  <button id="login-btn">Login</button>

  <p>New user? <a href="/signup" id="go-register">Register</a></p>
</script>

<script type="text/template" id="signup-template">
  <h2>Register</h2>

  <input type="text" id="email" placeholder="Email"><br><br>
  <input type="password" id="password" placeholder="Password"><br><br>

  <button id="signup-btn">Register</button>

  <p>Already user? <a href="/login" id="go-login">Login</a></p>
</script>

<script type="text/template" id="dashboard-template">
  <h2>Dashboard</h2>

  <button id="logout-btn">Logout</button>

  <hr>

  <h3>Create Task</h3>

  <input type="text" id="title" placeholder="Enter title"><br><br>
  <textarea id="description" placeholder="Enter description"></textarea><br><br>

  <select id="status">
    <option value="pending">Pending</option>
    <option value="progress">Progress</option>
    <option value="completed">Completed</option>
  </select><br><br>

  <button id="create-task-btn">Create Task</button>

  <hr>

  <h3>Your Tasks</h3>

  <input type="text" placeholder="Search tasks..."><br><br>

  <table border="1" width="100%">
    <thead>
      <tr>
        <th>Title</th>
        <th>Status</th>
        <th>Actions</th>
      </tr>
    </thead>
    <tbody id="task-list">
      <!-- tasks will come later -->
      <tr>
        <td>Sample Task</td>
        <td>Pending</td>
        <td>
          <button>Edit</button>
          <button>Delete</button>
        </td>
      </tr>
    </tbody>
  </table>
</script>